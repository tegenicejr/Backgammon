      blackWins: "黒（Black）の勝利！",
      singleWinType: "シングル勝ち (通常勝利)",
      gammonWinType: "ギャモン勝ち (2倍勝利)！",
      bgWinType: "バックギャモン勝ち (3倍勝利)！",
      shareX: "Xで結果をポスト",
      playAgain: "もう一度遊ぶ",
      noMoves: "動かせる駒がありません。パスします。",
      xPostText: "Games Clubhouseでバックギャモンに勝利しました！"
    }
  };

  // --- GAME STATE ---
  const state = {
    // board: 1-indexed (1 to 24), positive = White, negative = Black
    board: new Array(25).fill(0),
    bar: { white: 0, black: 0 },
    borneOff: { white: 0, black: 0 },
    turn: 'white', // 'white' or 'black'
    mode: 'cpu',   // 'cpu' or 'local'
    difficulty: 'normal', // 'easy', 'normal', 'hard'
    dice: [],      // available numbers to move
    rawDice: [],   // original rolled pair
    selectedPoint: null, // point index, 'bar', or null
    validMoves: [],      // targets for selectedPoint
    gameActive: false,
    waitingForRoll: true,
    isThinking: false
  };

  let currentSettings = window.storageManager.getSettings();

  // --- INITIAL POSITION SETUP ---
  // Standard Backgammon setup
  function initBoardStandard() {
    state.board.fill(0);
    state.bar = { white: 0, black: 0 };
    state.borneOff = { white: 0, black: 0 };

    // White moves 1 -> 24
    // Black moves 24 -> 1
    state.board[1] = 2;    // White
    state.board[12] = 5;   // White
    state.board[17] = 3;   // White
    state.board[19] = 5;   // White

    state.board[24] = -2;  // Black
    state.board[13] = -5;  // Black
    state.board[8] = -3;   // Black
    state.board[6] = -5;   // Black

    state.turn = 'white';
    state.dice = [];
    state.rawDice = [];
    state.selectedPoint = null;
    state.validMoves = [];
    state.waitingForRoll = true;
    state.isThinking = false;
  }

  // --- DOM CACHE ---
  const screens = {
    title: document.getElementById('title-screen'),
    game: document.getElementById('game-screen')
  };

  const modals = {
    rules: document.getElementById('rules-modal'),
    stats: document.getElementById('stats-modal'),
    settings: document.getElementById('settings-modal'),
    confirm: document.getElementById('confirm-modal'),
    result: document.getElementById('result-modal'),
    pass: document.getElementById('pass-modal')
  };

  const UI = {
    turnBadge: document.getElementById('turn-badge'),
    thinkingBadge: document.getElementById('cpu-thinking-badge'),
    pipBlack: document.getElementById('pip-black'),
    pipWhite: document.getElementById('pip-white'),
    diceContainer: document.getElementById('dice-container'),
    btnRoll: document.getElementById('btn-roll-dice'),
    toast: document.getElementById('toast-message'),
    btnResume: document.getElementById('btn-resume-game')
  };

  // --- I18N APPLY ---
  function applyLanguage(lang) {
    currentSettings.lang = lang;
    window.storageManager.saveSettings(currentSettings);

    const dict = I18N[lang] || I18N.en;
    document.querySelectorAll('[data-i18n]').forEach(el => {
      const key = el.getAttribute('data-i18n');
      if (dict[key]) el.textContent = dict[key];
    });

    document.getElementById('btn-lang-en').classList.toggle('active', lang === 'en');
    document.getElementById('btn-lang-ja').classList.toggle('active', lang === 'ja');

    updateStatusUI();
  }

  // --- HAPTICS HELPER ---
  function triggerHaptic(duration = 20) {
    if (currentSettings.vibrate && navigator.vibrate) {
      try { navigator.vibrate(duration); } catch (e) {}
    }
  }

  // --- BOARD GENERATION (SVG POINTS) ---
  function constructBoardDOM() {
    const quadrants = {
      tl: document.getElementById('quad-tl'),
      tr: document.getElementById('quad-tr'),
      bl: document.getElementById('quad-bl'),
      br: document.getElementById('quad-br')
    };

    // Point mapping
    // TL: 12 down to 7
    // TR: 6 down to 1
    // BL: 13 up to 18
    // BR: 19 up to 24
    const config = [
      { quad: quadrants.tl, points: [12, 11, 10, 9, 8, 7], isTop: true },
      { quad: quadrants.tr, points: [6, 5, 4, 3, 2, 1], isTop: true },
      { quad: quadrants.bl, points: [13, 14, 15, 16, 17, 18], isTop: false },
      { quad: quadrants.br, points: [19, 20, 21, 22, 23, 24], isTop: false }
    ];

    config.forEach(({ quad, points, isTop }) => {
      quad.innerHTML = '';
      points.forEach(pt => {
        const col = document.createElement('div');
        col.className = 'point-col';
        col.dataset.point = pt;

        const isEven = pt % 2 === 0;
        const colorClass = isEven ? 'triangle-even' : 'triangle-odd';

        // Inline SVG triangle
        col.innerHTML = `
          <svg class="triangle-svg" viewBox="0 0 100 200" preserveAspectRatio="none">
            <polygon points="${isTop ? '0,0 100,0 50,195' : '0,200 100,200 50,5'}" class="${colorClass}" />
          </svg>
          <span class="point-number">${pt}</span>
          <div class="checker-stack"></div>
        `;

        col.addEventListener('click', () => handlePointClick(pt));
        quad.appendChild(col);
      });
    });

    document.getElementById('bar-white').addEventListener('click', () => handleBarClick('white'));
    document.getElementById('bar-black').addEventListener('click', () => handleBarClick('black'));
    document.getElementById('tray-white').addEventListener('click', () => handleTrayClick('white'));
    document.getElementById('tray-black').addEventListener('click', () => handleTrayClick('black'));
  }

  // --- RENDER REFRESH ---
  function renderBoard() {
    // 1. Points
    for (let pt = 1; pt <= 24; pt++) {
      const col = document.querySelector(`.point-col[data-point="${pt}"]`);
      if (!col) continue;
      const stack = col.querySelector('.checker-stack');
      stack.innerHTML = '';

      const count = state.board[pt];
      const absCount = Math.abs(count);
      const isWhite = count > 0;

      col.classList.remove('selected', 'legal-target');
      if (state.selectedPoint === pt) col.classList.add('selected');
      if (state.validMoves.includes(pt)) col.classList.add('legal-target');

      const maxDisplay = Math.min(absCount, 5);
      for (let i = 0; i < maxDisplay; i++) {
        const checker = document.createElement('div');
        checker.className = `checker ${isWhite ? 'white' : 'black'}`;
        if (i === maxDisplay - 1 && absCount > 5) {
          const badge = document.createElement('span');
          badge.className = 'checker-count-badge';
          badge.textContent = absCount;
          checker.appendChild(badge);
        }
        stack.appendChild(checker);
      }
    }

    // 2. Bar
    ['white', 'black'].forEach(color => {
      const slot = document.getElementById(`bar-${color}`);
      slot.innerHTML = '';
      const count = state.bar[color];
      for (let i = 0; i < Math.min(count, 4); i++) {
        const ch = document.createElement('div');
        ch.className = `checker ${color}`;
        if (i === Math.min(count, 4) - 1 && count > 4) {
          const b = document.createElement('span');
          b.className = 'checker-count-badge';
          b.textContent = count;
          ch.appendChild(b);
        }
        slot.appendChild(ch);
      }
      slot.parentElement.classList.toggle('selected', state.selectedPoint === 'bar' && state.turn === color);
    });

    // 3. Bear-Off Trays
    ['white', 'black'].forEach(color => {
      const tray = document.getElementById(`tray-${color}`);
      tray.innerHTML = '';
      tray.classList.remove('legal-target');
      if (state.validMoves.includes(color === 'white' ? 25 : 0)) {
        tray.classList.add('legal-target');
      }
      const count = state.borneOff[color];
      for (let i = 0; i < count; i++) {
        const chip = document.createElement('div');
        chip.className = `tray-chip ${color}`;
        tray.appendChild(chip);
      }
    });

    // 4. Dice & Controls
    renderDice();
    updateStatusUI();
    calculatePipCounts();
  }

  // --- DICE RENDERING ---
  function renderDice() {
    UI.diceContainer.innerHTML = '';
    const dict = I18N[currentSettings.lang] || I18N.en;

    if (state.rawDice.length > 0) {
      state.rawDice.forEach((dieVal, idx) => {
        const box = document.createElement('div');
        box.className = 'die-box';
        const isUsed = !state.dice.includes(dieVal);
        if (isUsed) box.classList.add('used');

        box.innerHTML = getDiceDotsHTML(dieVal);
        UI.diceContainer.appendChild(box);
      });
    }

    UI.btnRoll.style.display = (state.waitingForRoll && !state.isThinking) ? 'block' : 'none';
  }

  function getDiceDotsHTML(val) {
    const dot = '<span class="die-dot"></span>';
    const rdot = '<span class="die-dot red"></span>';
    const empty = '<span></span>';
    switch (val) {
      case 1:
        return `${empty}${empty}${empty}${empty}${rdot}${empty}${empty}${empty}${empty}`;
      case 2:
        return `${dot}${empty}${empty}${empty}${empty}${empty}${empty}${empty}${dot}`;
      case 3:
        return `${dot}${empty}${empty}${empty}${dot}${empty}${empty}${empty}${dot}`;
      case 4:
        return `${dot}${empty「Games Clubhouse」バックギャモンの実装を開始します。
スマホ縦持ち（100dvh）でもデスクトップでも快適に遊べるレスポンシブ縦型最適化ボードを採用し、外部アセットゼロ（インラインSVG・CSSグラフィック）、Web Audio APIによる木製チェッカー＆ダイス効果音、思考ウェイト付きCPU、I18N（日・英）、オートセーブを完備した完全コードをお届けします。

